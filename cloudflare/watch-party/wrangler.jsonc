{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-watch-party",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "NovaPartyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NovaPartyRoom"] }],
  "vars": {
    "NOVA_RELAY_ORIGIN": "https://nova-watch-party.YOUR-SUBDOMAIN.workers.dev",
    "NOVA_SUPABASE_URL": "https://hcyysnagdumpviromdzl.supabase.co",
    "NOVA_SUPABASE_PUBLIC_KEY": "SET-YOUR-PUBLISHABLE-KEY"
  }
}
